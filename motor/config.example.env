# Copie para motor/.env e preencha. O .env NUNCA vai pro git (está no .gitignore).

# --- Hermes (Nous) — API do gateway local
HERMES_URL=http://127.0.0.1:8642
HERMES_KEY=                         # = API_SERVER_KEY do .env do usuário hermes
HERMES_CAMPO_PROMPT=input           # nome do campo do prompt no POST /v1/runs (confira no HERMES_SETUP.md)
HERMES_TIMEOUT_MIN=25

# --- Plano B se o Hermes cair (qualquer endpoint compatível com OpenAI; ex.: o LiteLLM da VPS)
LLM_FALLBACK_URL=                   # ex.: http://127.0.0.1:4000/v1
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODELO=nous-primary

# --- Telegram (o mesmo bot do Ultron serve: só ENVIAR mensagem não briga com o webhook do n8n)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site
SITE_URL=https://vulto.tech
GIT_BRANCH=main

# --- Publicar sozinho às 9h se você não responder (deixe false no 1º mês)
AUTO_PUBLICAR=false

# --- Quantas horas pra trás buscar notícia
MOTOR_JANELA_HORAS=72
